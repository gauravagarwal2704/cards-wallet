<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Flutter must launch a stable component even after an icon alias is disabled.
         Release builds keep the selectable launcher aliases in the main manifest. -->
    <application>
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity-alias android:name=".MainActivityThreeD">
            <intent-filter tools:node="removeAll" />
        </activity-alias>
        <activity-alias android:name=".MainActivityPurple">
            <intent-filter tools:node="removeAll" />
        </activity-alias>
        <activity-alias android:name=".MainActivityMulticolor">
            <intent-filter tools:node="removeAll" />
        </activity-alias>
        <activity-alias android:name=".MainActivityOcean">
            <intent-filter tools:node="removeAll" />
        </activity-alias>
        <activity-alias android:name=".MainActivityEmerald">
            <intent-filter tools:node="removeAll" />
        </activity-alias>
        <activity-alias android:name=".MainActivitySunset">
            <intent-filter tools:node="removeAll" />
        </activity-alias>
        <activity-alias android:name=".MainActivityRed">
            <intent-filter tools:node="removeAll" />
        </activity-alias>
    </application>
</manifest>
